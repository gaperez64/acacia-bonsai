import SymmetryProofs.Transports

namespace Symmetry
variable {α β : Type}
variable {A : Automaton n a}

/-- C++: equivariant_k_bounded_safety_aut.hh:388–432. Lift a coordinate
    permutation to the finite game-state or letter space. -/
def actionPerm (p : Perm α) : Perm (α → β) where
  toFun := act p
  invFun := act p.symm
  left_inv := act_inverse p
  right_inv := act_inverse' p

/-- C++: equivariant_k_bounded_safety_aut.hh:388–432, 730–736.
    Reuse the representative T by moving its raw coordinates. -/
def reuseT (A : Automaton n a) (K : Nat) (side : Bool) (s : Verified A)
    (X : Region n K) (i : Fin a → Bool) : Region n K :=
  image s.states (computeT A K side X i)

/-- The exact T_member = phi · T_rep identity used by the implementation,
    provided the source is symmetric; symmetry.hh:14–17, issue #331. -/
theorem reuse_exact (s : Verified A) (K : Nat) (side : Bool) (X : Region n K)
    (hx : Invariant s.states X) (i : Fin a → Bool) :
    reuseT A K side s X i = computeT A K side X (act s.aps i) := by
  funext f
  have h := computeT_commutes s K side X i (act s.states.symm f)
  rw [image_eq _ _ hx] at h
  simpa [reuseT, image] using h.symm

/-- C++: equivariant_k_bounded_safety_aut.hh:41–48, 727–744. `members` is
    the match_slots/phi_from_sigma transport for each next_permutation result. -/
structure InputOrbit (A : Automaton n a) where
  representative : Fin a → Bool
  members : List (Verified A)

/-- C++: equivariant_k_bounded_safety_aut.hh:727–744. Compute T once from X,
    then intersect every transported member with the evolving raw region. -/
def orbitUpdate (A : Automaton n a) (K : Nat) (side : Bool)
    (O : InputOrbit A) (X : Region n K) : Region n K :=
  let T := computeT A K side X O.representative
  O.members.foldl (fun Y s => fun f => Y f && image s.states T f) X

/-- C++: equivariant_k_bounded_safety_aut.hh:727–744. The same snapshot update
    written pointwise; sequential meets do not change their intersection. -/
def plainOrbit (A : Automaton n a) (K : Nat) (side : Bool)
    (O : InputOrbit A) (X : Region n K) : Region n K :=
  fun f => X f && O.members.all (fun s => computeT A K side X (act s.aps O.representative) f)

theorem fold_meets (ss : List β) (T : β → α → Bool) (X : α → Bool) :
    ss.foldl (fun Y s => fun f => Y f && T s f) X =
      fun f => X f && ss.all (fun s => T s f) := by
  induction ss generalizing X with
  | nil => simp
  | cons s ss ih =>
    rw [List.foldl_cons, ih]
    funext f
    simp only [List.all_cons, Bool.and_assoc]

/-- An orbit sweep computes the exact intersection of all its member input
    predecessors using the SAME source snapshot. This is the literal reuse
    step at equivariant:727–744, symmetry.hh:14–17, issue #331. -/
theorem orbitUpdate_exact (K : Nat) (side : Bool) (O : InputOrbit A) (X : Region n K)
    (h : ∀ s ∈ O.members, Invariant s.states X) :
    orbitUpdate A K side O X = plainOrbit A K side O X := by
  rw [orbitUpdate, fold_meets]
  funext f
  congr 1
  apply Bool.eq_iff_iff.mpr
  simp only [List.all_eq_true]
  constructor
  · intro hall s hs
    have he := congrFun (reuse_exact s K side X (h s hs) O.representative) f
    exact he ▸ hall s hs
  · intro hall s hs
    have he := congrFun (reuse_exact s K side X (h s hs) O.representative) f
    change reuseT A K side s X O.representative f = true
    rw [he]
    exact hall s hs

/-- C++: equivariant_k_bounded_safety_aut.hh:727–744. Orbit's projected engine-input set; unused protagonist bits are false. -/
def orbitLetters (side : Bool) (O : InputOrbit A) : List (Fin a → Bool) :=
  O.members.map fun s => opponentProjection A side (act s.aps O.representative)

/-- C++: equivariant_k_bounded_safety_aut.hh:217–273, 727–744.
    Transports are generated by the stored swaps; coverage and closure are
    after projecting onto the opponent side. Enumerator correctness is separate. -/
structure SweepPlan (A : Automaton n a) (side : Bool) where
  generators : List (Verified A)
  orbits : List (InputOrbit A)
  member_generated : ∀ O ∈ orbits, ∀ s ∈ O.members, GeneratedBy generators s.states s.aps
  orbit_closed : ∀ O ∈ orbits, ∀ s ∈ generators,
    ∀ i ∈ orbitLetters side O, act s.aps i ∈ orbitLetters side O
  covers : ∀ i, ∃ O ∈ orbits, opponentProjection A side i ∈ orbitLetters side O

/-- C++: equivariant_k_bounded_safety_aut.hh:727–744. Each orbit takes a fresh
    snapshot, after all updates from the preceding orbit. -/
def sweep (A : Automaton n a) (K : Nat) (side : Bool) (P : SweepPlan A side)
    (X : Region n K) : Region n K :=
  P.orbits.foldl (fun Y O => orbitUpdate A K side O Y) X

/-- C++: equivariant_k_bounded_safety_aut.hh:518–553. Invariance for all supplied
    generators suffices; their products need no additional game hypotheses. -/
def Symmetric (G : List (Verified A)) (X : Region n K) : Prop :=
  ∀ s ∈ G, Invariant s.states X

theorem orbitUpdate_shrinks (K : Nat) (side : Bool) (O : InputOrbit A) (X : Region n K) :
    Subset (orbitUpdate A K side O X) X := by
  rw [orbitUpdate, fold_meets]
  exact fun _ h => (Bool.and_eq_true_iff.mp h).1

theorem fold_shrinks (xs : List β) (F : β → (α → Bool) → α → Bool)
    (h : ∀ b X, Subset (F b X) X) (X : α → Bool) :
    Subset (xs.foldl (fun Y b => F b Y) X) X := by
  induction xs generalizing X with
  | nil => exact fun _ hf => hf
  | cons b xs ih => exact fun f hf => h b X f (ih (F b X) f hf)

theorem subset_antisymm {X Y : α → Bool} (h : Subset X Y) (h' : Subset Y X) : X = Y := by
  funext f
  exact Bool.eq_iff_iff.mpr ⟨h f, h' f⟩

theorem fold_fixed (xs : List β) (F : β → (α → Bool) → α → Bool)
    (h : ∀ b X, Subset (F b X) X) (X : α → Bool)
    (fixed : xs.foldl (fun Y b => F b Y) X = X) : ∀ b ∈ xs, F b X = X := by
  induction xs generalizing X with
  | nil => simp
  | cons b xs ih =>
    have hb : F b X = X := subset_antisymm (h b X) (by
      intro f hf
      rw [← fixed] at hf
      exact fold_shrinks xs F h (F b X) f hf)
    have ht : xs.foldl (fun Y b => F b Y) X = X := by simpa [hb] using fixed
    intro c hc
    rcases List.mem_cons.mp hc with rfl | hc
    · exact hb
    · exact ih X ht c hc

theorem sweep_shrinks (K : Nat) (side : Bool) (P : SweepPlan A side) (X : Region n K) :
    Subset (sweep A K side P X) X :=
  fold_shrinks P.orbits (fun O Y => orbitUpdate A K side O Y) (orbitUpdate_shrinks K side) X

theorem plainOrbit_invariant (K : Nat) (side : Bool) (O : InputOrbit A)
    (X : Region n K) (s : Verified A) (hx : Invariant s.states X)
    (closed : ∀ i ∈ orbitLetters side O, act s.aps i ∈ orbitLetters side O) :
    Invariant s.states (plainOrbit A K side O X) := by
  intro f
  have ht : ∀ i, computeT A K side X (act s.aps i) (act s.states f) =
      computeT A K side X i f := by
    intro i
    have h := computeT_commutes s K side X i f
    rw [image_eq _ _ hx] at h
    exact h
  have hc := finite_closed_iff (orbitLetters side O) (actionPerm s.aps) closed
  have hall : ∀ g, O.members.all (fun t => computeT A K side X (act t.aps O.representative) g) = true ↔
      ∀ i ∈ orbitLetters side O, computeT A K side X i g = true := by
    intro g
    simp [orbitLetters, List.all_eq_true, computeT_projected]
  apply Bool.eq_iff_iff.mpr
  simp only [plainOrbit, Bool.and_eq_true, hx f, hall]
  apply and_congr_right
  intro _
  constructor
  · intro h i hi
    rw [← ht i]
    exact h _ (closed i hi)
  · intro h i hi
    have hm : act s.aps.symm i ∈ orbitLetters side O :=
      (hc (act s.aps.symm i)).mp (by simpa [actionPerm] using hi)
    have hh := ht (act s.aps.symm i)
    simp only [act_inverse'] at hh
    rw [hh]
    exact h _ hm

theorem orbitUpdate_symmetric (K : Nat) (side : Bool) (P : SweepPlan A side)
    (O : InputOrbit A) (ho : O ∈ P.orbits) (X : Region n K)
    (hx : Symmetric P.generators X) : Symmetric P.generators (orbitUpdate A K side O X) := by
  rw [orbitUpdate_exact K side O X (fun s hs => generated_invariant (P.member_generated O ho s hs) hx)]
  intro s hs
  exact plainOrbit_invariant K side O X s (hx s hs) (P.orbit_closed O ho s hs)

theorem sweep_symmetric (K : Nat) (side : Bool) (P : SweepPlan A side) (X : Region n K)
    (hx : Symmetric P.generators X) : Symmetric P.generators (sweep A K side P X) := by
  have go : ∀ os : List (InputOrbit A), (∀ O ∈ os, O ∈ P.orbits) → ∀ Y, Symmetric P.generators Y →
      Symmetric P.generators (os.foldl (fun Z O => orbitUpdate A K side O Z) Y) := by
    intro os
    induction os with
    | nil => exact fun _ _ h => h
    | cons O os ih =>
      intro h Y hy
      apply ih (fun o ho => h o (List.mem_cons_of_mem _ ho))
      exact orbitUpdate_symmetric K side P O (h _ (by simp)) Y hy
  exact go P.orbits (fun _ h => h) X hx

/-- No winning vector is removed, even as later orbit snapshots use a smaller
    working region. This proves the actual sweep update order sound;
    equivariant:721–774, symmetry.hh:14–17, issue #331. -/
theorem sweep_preserves_winner (K : Nat) (side : Bool) (P : SweepPlan A side)
    (X : Region n K) (hx : Subset (final A K side) X) :
    Subset (final A K side) (sweep A K side P X) := by
  have one : ∀ O Y, Subset (final A K side) Y →
      Subset (final A K side) (orbitUpdate A K side O Y) := by
    intro O Y hy
    rw [orbitUpdate, fold_meets]
    intro f hf
    apply Bool.and_eq_true_iff.mpr
    refine ⟨hy f hf, List.all_eq_true.mpr ?_⟩
    intro s _
    change computeT A K side Y O.representative (act s.states.symm f) = true
    apply computeT_mono A K side hy
    have hw : final A K side (act s.states.symm f) = true := by
      have hi := final_invariant s K side (act s.states.symm f)
      simpa [hf] using hi.symm
    have hc : cpre A K side (final A K side) (act s.states.symm f) = true := by
      rw [final_fixed]; exact hw
    obtain ⟨_, h⟩ := (cpre_iff _ _ _ _ _).mp hc
    exact (computeT_iff _ _ _ _ _ _).mpr (h O.representative)
  unfold sweep
  induction P.orbits generalizing X with
  | nil => exact hx
  | cons O os ih => exact ih (orbitUpdate A K side O X) (one O X hx)

/-- C++: equivariant_k_bounded_safety_aut.hh:721–774. Terminating finite-state
    form of the sweep loop, at a fixed bound. -/
def sweepFinal (A : Automaton n a) (K : Nat) (side : Bool) (P : SweepPlan A side) : Region n K :=
  iterate (sweep A K side P) (safe A K) (states n K).length

/-- Every terminating sweep fixed point is a plain CPre fixed point, since
    all projected input orbits were covered by generated transports (#331);
    equivariant:727–774 and symmetry.hh:14–17. -/
theorem sweep_fixed_cpre (K : Nat) (side : Bool) (P : SweepPlan A side) (X : Region n K)
    (hx : Symmetric P.generators X) (hf : sweep A K side P X = X) :
    cpre A K side X = X := by
  apply subset_antisymm (cpre_shrinks A K side X)
  intro f hxf
  apply (cpre_iff _ _ _ _ _).mpr
  refine ⟨hxf, fun i => ?_⟩
  obtain ⟨O, ho, hi⟩ := P.covers i
  obtain ⟨s, hs, he⟩ := List.mem_map.mp hi
  have hO := fold_fixed P.orbits (fun O Y => orbitUpdate A K side O Y)
    (orbitUpdate_shrinks K side) X hf O ho
  rw [orbitUpdate_exact K side O X (fun s hs => generated_invariant (P.member_generated O ho s hs) hx)] at hO
  have hm : plainOrbit A K side O X f = true := by rw [hO]; exact hxf
  have ht := List.all_eq_true.mp (Bool.and_eq_true_iff.mp hm).2 s hs
  have hp : computeT A K side X (opponentProjection A side i) f = true := by
    rw [← he, computeT_projected]
    exact ht
  rw [computeT_projected] at hp
  exact (computeT_iff _ _ _ _ _ _).mp hp

/-- The actual snapshot-and-intersection sweep has exactly the same final set
    and verdict as plain CPre, in BOTH frames. Intermediate orbit snapshots are
    preserved; no simultaneous-update assumption is used. symmetry.hh:14–17, #331. -/
theorem sweepFinal_eq (K : Nat) (side : Bool) (P : SweepPlan A side) :
    sweepFinal A K side P = final A K side := by
  let F := sweep A K side P
  have hs : ∀ X, Subset (F X) X := sweep_shrinks K side P
  have inv : ∀ k, Symmetric P.generators (iterate F (safe A K) k) := by
    intro k
    induction k with
    | zero => exact fun s _ => safe_commutes s K
    | succ k ih => exact sweep_symmetric K side P _ ih
  have contains : ∀ k, Subset (final A K side) (iterate F (safe A K) k) := by
    intro k
    induction k with
    | zero => exact stage_safe K side _
    | succ k ih => exact sweep_preserves_winner K side P _ ih
  have bounded : ∀ k, Subset (iterate F (safe A K) k) (safe A K) := by
    intro k
    induction k with
    | zero => exact fun _ h => h
    | succ k ih => exact fun f h => ih f (hs _ f h)
  have fixed := iterate_stable (states n K) mem_states F hs (states n K).length
    (safe A K) (List.length_filter_le ..)
  have post := sweep_fixed_cpre K side P (sweepFinal A K side P) (inv _) fixed
  apply subset_antisymm
  · apply final_greatest K side _ (bounded _)
    intro f h
    change cpre A K side (sweepFinal A K side P) f = true
    rw [post]; exact h
  · exact contains _

end Symmetry
