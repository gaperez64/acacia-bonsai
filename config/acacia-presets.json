{
  "presets": {
    "base": {},
    "base_iosprecom_mona": {
      "ios_precomputer": "mona"
    },
    "best": {
      "aut_preprocessor": "standard",
      "ios_precomputer": "powset",
      "input_picker": "critical",
      "simd_is_max": false,
      "decompose_spec": false
    },
    "best_mona": {
      "aut_preprocessor": "standard",
      "ios_precomputer": "mona",
      "input_picker": "critical",
      "simd_is_max": false,
      "decompose_spec": false
    },
    "best_decomp_mona": {
      "aut_preprocessor": "standard",
      "ios_precomputer": "mona",
      "input_picker": "critical",
      "simd_is_max": false,
      "decompose_spec": true,
      "enable_equivariant_solver": true
    },
    "best_decomp_mona_noequivariant": {
      "inherits": "best_decomp_mona",
      "enable_equivariant_solver": false
    },
    "best_decomp_mona_any": {
      "inherits": "best_decomp_mona",
      "translation_pref": "any"
    },
    "best_decomp_mona_race": {
      "inherits": "best_decomp_mona",
      "translation_pref": "small+any"
    },
    "best_decomp_kdtree_mona": {
      "inherits": "best_decomp_mona",
      "vector_downset": "kdtree_backed"
    },
    "best_decomp_bboxtree_mona": {
      "inherits": "best_decomp_mona",
      "vector_downset": "bboxtree_backed"
    },
    "best_decomp_bboxtree_mona_noequivariant": {
      "inherits": "best_decomp_bboxtree_mona",
      "enable_equivariant_solver": false
    },
    "best_decomp_comptrie_mona": {
      "inherits": "best_decomp_mona",
      "vector_downset": "comptrie_backed"
    },
    "best_decomp_sharingtrie_mona": {
      "inherits": "best_decomp_mona",
      "vector_downset": "sharingtrie_backed"
    },
    "best_decomp_simpsharingtree_mona": {
      "inherits": "best_decomp_mona",
      "vector_downset": "simple_sharingtree_backed"
    },
    "best_decomp_sharingtree_mona": {
      "inherits": "best_decomp_mona",
      "vector_downset": "sharingtree_backed"
    },
    "best_decomp_mona_diag": {
      "inherits": "best_decomp_mona",
      "enable_diagnostics": true
    },
    "best_decomp_skiplist_mona": {
      "inherits": "best_decomp_mona",
      "vector_downset": "skiplist_backed"
    },
    "best_decomp_cst_mona": {
      "inherits": "best_decomp_mona",
      "vector_downset": "cst_backed"
    },
    "best_decomp_rank_bucketed_mona": {
      "inherits": "best_decomp_mona",
      "vector_downset": "rank_bucketed_vector_backed"
    },
    "best_decomp_rank_bucketed_mona_race": {
      "inherits": "best_decomp_rank_bucketed_mona",
      "translation_pref": "small+any"
    },
    "best_decomp_rank_bucketed_mona_noequivariant": {
      "inherits": "best_decomp_rank_bucketed_mona",
      "enable_equivariant_solver": false
    },
    "best_decomp_rank_bucketed_mona_eq_baseline": {
      "inherits": "best_decomp_rank_bucketed_mona",
      "equivariant_max_states": 512,
      "equivariant_min_clients": 3,
      "equivariant_min_blocks": 4
    },
    "best_decomp_rank_bucketed_mona_eq_min_clients_2": {
      "inherits": "best_decomp_rank_bucketed_mona",
      "equivariant_max_states": 512,
      "equivariant_min_clients": 2,
      "equivariant_min_blocks": 4
    },
    "best_decomp_rank_bucketed_mona_eq_max_states_2048": {
      "inherits": "best_decomp_rank_bucketed_mona",
      "equivariant_max_states": 2048,
      "equivariant_min_clients": 3,
      "equivariant_min_blocks": 4
    },
    "best_decomp_rank_bucketed_mona_eq_min_blocks_2": {
      "inherits": "best_decomp_rank_bucketed_mona",
      "equivariant_max_states": 512,
      "equivariant_min_clients": 3,
      "equivariant_min_blocks": 2
    },
    "best_decomp_filtered_vector_mona": {
      "inherits": "best_decomp_mona",
      "vector_downset": "filtered_vector_backed"
    },
    "best_decomp_filtered_vector_mona_noequivariant": {
      "inherits": "best_decomp_filtered_vector_mona",
      "enable_equivariant_solver": false
    }
  },
  "tool_baselines": {
    "ltlsynt": {
      "description": "external benchmark backend",
      "suite_prefix": "ltlsynt",
      "env": {}
    },
    "ltlsynt_no_decompose": {
      "description": "ltlsynt with decomposition disabled",
      "suite_prefix": "ltlsynt",
      "env": {
        "LTLSYNT_OPTS": "--decompose=no"
      }
    },
    "ltlsynt_no_bypass": {
      "description": "ltlsynt with bypass/direct-strategy checks disabled",
      "suite_prefix": "ltlsynt",
      "env": {
        "LTLSYNT_OPTS": "--bypass=no"
      }
    },
    "ltlsynt_no_obligation": {
      "description": "ltlsynt with obligation synthesis disabled",
      "suite_prefix": "ltlsynt",
      "env": {
        "LTLSYNT_OPTS": "--obligation-synthesis=no"
      }
    },
    "ltlsynt_no_specials": {
      "description": "ltlsynt with decomposition, bypass, and obligation synthesis disabled",
      "suite_prefix": "ltlsynt",
      "env": {
        "LTLSYNT_OPTS": "--decompose=no --bypass=no --obligation-synthesis=no"
      }
    }
  },
  "groups": {
    "docker_default": [
      "best_decomp_rank_bucketed_mona",
      "best_decomp_mona",
      "best_decomp_mona_any",
      "best_decomp_bboxtree_mona"
    ],
    "local_tuning_default": [
      "best_decomp_mona",
      "best_decomp_mona_any",
      "best_mona",
      "base_iosprecom_mona",
      "best_decomp_kdtree_mona",
      "best_decomp_bboxtree_mona",
      "best_decomp_comptrie_mona",
      "best_decomp_sharingtrie_mona",
      "best_decomp_sharingtree_mona",
      "best_decomp_simpsharingtree_mona",
      "best_decomp_skiplist_mona",
      "best_decomp_cst_mona",
      "best_decomp_rank_bucketed_mona",
      "best_decomp_filtered_vector_mona"
    ],
    "posets_downset_sweep": [
      "best_decomp_mona",
      "best_decomp_mona_any",
      "best_decomp_kdtree_mona",
      "best_decomp_bboxtree_mona",
      "best_decomp_comptrie_mona",
      "best_decomp_sharingtrie_mona",
      "best_decomp_sharingtree_mona",
      "best_decomp_simpsharingtree_mona",
      "best_decomp_skiplist_mona",
      "best_decomp_cst_mona",
      "best_decomp_rank_bucketed_mona",
      "best_decomp_filtered_vector_mona"
    ]
  }
}
