{
  "families": {
    "aut_preprocessor": {
      "meson": "acacia_aut_preprocessor",
      "default": "surely_losing",
      "choices": {
        "surely_losing": {
          "type": "aut_preprocessors::surely_losing",
          "gate": "ACACIA_ENABLE_AUT_PREPROCESSOR_SURELY_LOSING"
        },
        "standard": {
          "type": "aut_preprocessors::standard",
          "gate": "ACACIA_ENABLE_AUT_PREPROCESSOR_STANDARD"
        }
      },
      "macro": "AUT_PREPROCESSOR"
    },
    "ios_precomputer": {
      "meson": "acacia_ios_precomputer",
      "default": "standard",
      "choices": {
        "standard": {
          "type": "ios_precomputers::standard",
          "gate": "ACACIA_ENABLE_IOS_PRECOMPUTER_STANDARD"
        },
        "mona": {
          "type": "ios_precomputers::mona",
          "gate": "ACACIA_ENABLE_IOS_PRECOMPUTER_MONA"
        },
        "semantic_mona": {
          "type": "ios_precomputers::semantic_mona",
          "gate": "ACACIA_ENABLE_IOS_PRECOMPUTER_SEMANTIC_MONA"
        }
      },
      "macro": "IOS_PRECOMPUTER"
    },
    "input_picker": {
      "meson": "acacia_input_picker",
      "default": "critical_pq",
      "choices": {
        "critical_pq": {
          "type": "input_pickers::critical_pq",
          "gate": "ACACIA_ENABLE_INPUT_PICKER_CRITICAL_PQ"
        },
        "critical": {
          "type": "input_pickers::critical",
          "gate": "ACACIA_ENABLE_INPUT_PICKER_CRITICAL"
        }
      },
      "macro": "INPUT_PICKER"
    }
  },
  "options": {
    "translation_pref": {
      "meson": "acacia_translation_pref",
      "type": "combo",
      "default": "small",
      "choices": [
        "small",
        "any"
      ],
      "description": "Spot translator postprocessor preference list for realizability checks",
      "macros": [
        {
          "name": "ACACIA_TRANSLATION_PREF",
          "emit": "always",
          "encoding": "map",
          "map": {
            "small": "spot::postprocessor::Small",
            "any": "spot::postprocessor::Any"
          }
        },
        {
          "name": "ACACIA_TRANSLATION_PREFS",
          "emit": "always",
          "encoding": "map",
          "map": {
            "small": "spot::postprocessor::Small",
            "any": "spot::postprocessor::Any"
          }
        }
      ]
    },
    "forced_output_contradiction": {
      "meson": "acacia_forced_output_contradiction",
      "type": "boolean",
      "default": false,
      "description": "Enable the forced-output contradiction checker in the decision-only syntactic bypass",
      "macros": [
        {
          "name": "ACACIA_FORCED_OUTPUT_CONTRADICTION",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "enable_tlsf_frontend": {
      "meson": "acacia_enable_tlsf_frontend",
      "type": "boolean",
      "default": true,
      "description": "Build the optional native TLSF frontend (requires flex and bison)",
      "macros": [
        {
          "name": "ACACIA_ENABLE_TLSF_FRONTEND",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "native_arms": {
      "meson": "acacia_native_arms",
      "type": "boolean",
      "default": false,
      "description": "Build opt-in exact GR(1) arms, including the both-polarity arm, with the pinned tlsf-tools OxiDD API",
      "macros": [
        {
          "name": "ACACIA_NATIVE_ARMS",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "simd_is_max": {
      "meson": "acacia_simd_is_max",
      "type": "boolean",
      "default": true,
      "description": "Use SIMD maximum operations for vector comparisons",
      "macros": [
        {
          "name": "SIMD_IS_MAX",
          "emit": "always",
          "encoding": "bool_literal"
        }
      ]
    },
    "vector_downset": {
      "meson": "acacia_vector_downset",
      "type": "combo",
      "default": "vector_backed",
      "choices": [
        "vector_backed",
        "rank_bucketed_vector_backed"
      ],
      "description": "Downset implementation for vectors and bitsets",
      "macros": [
        {
          "name": "VECTOR_AND_BITSET_DOWNSET_IMPL",
          "emit": "always",
          "encoding": "value"
        }
      ]
    },
    "enable_diagnostics": {
      "meson": "acacia_enable_diagnostics",
      "type": "boolean",
      "default": false,
      "description": "Compile compact Acacia phase diagnostics, gated at runtime by ACACIA_DIAG",
      "macros": [
        {
          "name": "ACACIA_ENABLE_DIAGNOSTICS",
          "emit": "true",
          "encoding": "constant",
          "value": 1
        }
      ]
    },
    "default_arms": {
      "meson": "acacia_default_arms",
      "type": "string",
      "default": "",
      "description": "Default portfolio in --arms syntax; empty uses the historical default",
      "macros": [
        {
          "name": "ACACIA_DEFAULT_ARMS",
          "emit": "nonempty",
          "encoding": "c_string"
        }
      ]
    },
    "spot_lazy_provider": {
      "meson": "acacia_spot_lazy_provider",
      "type": "boolean",
      "default": false,
      "description": "Compile the explicitly selected Spot TAA provider for real and formula-unreal workers",
      "macros": [
        {
          "name": "ACACIA_SPOT_LAZY_PROVIDER",
          "emit": "true",
          "encoding": "constant",
          "value": 1
        }
      ]
    },
    "spot_guarded_backend": {
      "meson": "acacia_spot_guarded_backend",
      "type": "boolean",
      "default": false,
      "description": "Compile the explicitly selected Spot guarded-input safety-game backend",
      "macros": [
        {
          "name": "ACACIA_SPOT_GUARDED_BACKEND",
          "emit": "true",
          "encoding": "constant",
          "value": 1
        }
      ]
    },
    "forward_safety_solver": {
      "meson": "acacia_forward_safety_solver",
      "type": "boolean",
      "default": false,
      "description": "Use the on-the-fly forward safety-game solver instead of the backward antichain fixed point",
      "macros": [
        {
          "name": "ACACIA_FORWARD_SAFETY_SOLVER",
          "emit": "true",
          "encoding": "constant",
          "value": 1
        }
      ]
    },
    "enable_equivariant_solver": {
      "meson": "acacia_enable_equivariant_solver",
      "type": "boolean",
      "default": true,
      "description": "Compile and enable the exact equivariant solver path",
      "macros": [
        {
          "name": "ACACIA_ENABLE_EQUIVARIANT_SOLVER",
          "emit": "true",
          "encoding": "constant",
          "value": 1
        }
      ]
    },
    "preset": {
      "meson": "acacia_preset",
      "type": "string",
      "default": "",
      "description": "Named build configuration; excluded from hash and show fingerprints; empty for a hand-assembled configuration",
      "macros": [
        {
          "name": "ACACIA_PRESET",
          "emit": "nonempty",
          "encoding": "c_string"
        }
      ]
    }
  },
  "constants": {
    "VECTOR_ELT_T": {
      "value": "signed char",
      "description": "Counter element type. Check its signed-char range before changing the CLI K defaults or runtime bound checks.",
      "sources": [
        "src/config/acacia_build_config.hh.in",
        "src/arg_parser.hh",
        "src/arg_parser.cc"
      ]
    },
    "VECTOR_IMPL_AUTO": {
      "value": "simd_vector_backed",
      "description": "Fixed SIMD vector representation, using the portable SIMD dependency when the compiler lacks experimental/simd.",
      "sources": [
        "meson.build",
        "src/config/acacia_build_config.hh.in"
      ]
    }
  }
}
