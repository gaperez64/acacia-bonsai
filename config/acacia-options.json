{
  "families": {
    "aut_preprocessor": {
      "meson": "acacia_aut_preprocessor",
      "default": "surely_losing",
      "choices": {
        "surely_losing": {
          "type": "aut_preprocessors::surely_losing",
          "gate": "ACACIA_ENABLE_AUT_PREPROCESSOR_SURELY_LOSING"
        },
        "no_preprocessing": {
          "type": "aut_preprocessors::no_preprocessing",
          "gate": "ACACIA_ENABLE_AUT_PREPROCESSOR_NO_PREPROCESSING"
        },
        "standard": {
          "type": "aut_preprocessors::standard",
          "gate": "ACACIA_ENABLE_AUT_PREPROCESSOR_STANDARD"
        },
        "elevator": {
          "type": "aut_preprocessors::elevator",
          "gate": "ACACIA_ENABLE_AUT_PREPROCESSOR_ELEVATOR"
        }
      },
      "macro": "AUT_PREPROCESSOR"
    },
    "boolean_states": {
      "meson": "acacia_boolean_states",
      "default": "forward_saturation",
      "choices": {
        "forward_saturation": {
          "type": "boolean_states::forward_saturation",
          "gate": "ACACIA_ENABLE_BOOLEAN_STATES_FORWARD_SATURATION"
        },
        "no_boolean_states": {
          "type": "boolean_states::no_boolean_states",
          "gate": "ACACIA_ENABLE_BOOLEAN_STATES_NO_BOOLEAN_STATES"
        },
        "transition_core": {
          "type": "boolean_states::transition_core",
          "gate": "ACACIA_ENABLE_BOOLEAN_STATES_TRANSITION_CORE"
        }
      },
      "macro": "BOOLEAN_STATES"
    },
    "ios_precomputer": {
      "meson": "acacia_ios_precomputer",
      "default": "standard",
      "choices": {
        "standard": {
          "type": "ios_precomputers::standard",
          "gate": "ACACIA_ENABLE_IOS_PRECOMPUTER_STANDARD"
        },
        "delegate": {
          "type": "ios_precomputers::delegate",
          "gate": "ACACIA_ENABLE_IOS_PRECOMPUTER_DELEGATE"
        },
        "fake_vars": {
          "type": "ios_precomputers::fake_vars",
          "gate": "ACACIA_ENABLE_IOS_PRECOMPUTER_FAKE_VARS"
        },
        "powset": {
          "type": "ios_precomputers::powset",
          "gate": "ACACIA_ENABLE_IOS_PRECOMPUTER_POWSET"
        },
        "mona": {
          "type": "ios_precomputers::mona",
          "gate": "ACACIA_ENABLE_IOS_PRECOMPUTER_MONA"
        },
        "semantic_mona": {
          "type": "ios_precomputers::semantic_mona",
          "gate": "ACACIA_ENABLE_IOS_PRECOMPUTER_SEMANTIC_MONA"
        }
      },
      "macro": "IOS_PRECOMPUTER"
    },
    "actioner": {
      "meson": "acacia_actioner",
      "default": "standard",
      "choices": {
        "standard": {
          "type": "actioners::standard",
          "gate": "ACACIA_ENABLE_ACTIONER_STANDARD"
        },
        "no_ios_precomputation": {
          "type": "actioners::no_ios_precomputation",
          "gate": "ACACIA_ENABLE_ACTIONER_NO_IOS_PRECOMPUTATION"
        }
      },
      "macro": "ACTIONER"
    },
    "input_picker": {
      "meson": "acacia_input_picker",
      "default": "critical_pq",
      "choices": {
        "critical_pq": {
          "type": "input_pickers::critical_pq",
          "gate": "ACACIA_ENABLE_INPUT_PICKER_CRITICAL_PQ"
        },
        "critical": {
          "type": "input_pickers::critical",
          "gate": "ACACIA_ENABLE_INPUT_PICKER_CRITICAL"
        },
        "critical_rnd": {
          "type": "input_pickers::critical_rnd",
          "gate": "ACACIA_ENABLE_INPUT_PICKER_CRITICAL_RND"
        },
        "critical_fullrnd": {
          "type": "input_pickers::critical_fullrnd",
          "gate": "ACACIA_ENABLE_INPUT_PICKER_CRITICAL_FULLRND"
        }
      },
      "macro": "INPUT_PICKER"
    }
  },
  "options": {
    "default_k": {
      "meson": "acacia_default_k",
      "type": "integer",
      "default": 99,
      "min": 1,
      "max": 127,
      "description": "Default final K (bounded by the signed-char counter representation)",
      "macros": [
        {
          "name": "DEFAULT_K",
          "emit": "always",
          "encoding": "value"
        }
      ]
    },
    "default_kmin": {
      "meson": "acacia_default_kmin",
      "type": "integer",
      "default": 2,
      "min": 1,
      "max": 127,
      "description": "Default initial K (must not exceed acacia_default_k at runtime)",
      "macros": [
        {
          "name": "DEFAULT_KMIN",
          "emit": "always",
          "encoding": "value"
        }
      ]
    },
    "default_kinc": {
      "meson": "acacia_default_kinc",
      "type": "integer",
      "default": 3,
      "min": 1,
      "max": 127,
      "description": "Default K increment",
      "macros": [
        {
          "name": "DEFAULT_KINC",
          "emit": "always",
          "encoding": "value"
        }
      ]
    },
    "default_unreal_x": {
      "meson": "acacia_default_unreal_x",
      "type": "combo",
      "default": "both",
      "choices": [
        "both",
        "automaton",
        "formula"
      ],
      "description": "Default unrealizability check mode",
      "macros": [
        {
          "name": "DEFAULT_UNREAL_X",
          "emit": "always",
          "encoding": "map",
          "map": {
            "both": "UNREAL_X_BOTH",
            "automaton": "UNREAL_X_AUTOMATON",
            "formula": "UNREAL_X_FORMULA"
          }
        }
      ]
    },
    "default_spot_fast": {
      "meson": "acacia_default_spot_fast",
      "type": "combo",
      "default": "det",
      "choices": [
        "off",
        "det",
        "det_and_gfg"
      ],
      "description": "Default Spot fast-path strategy checks",
      "macros": [
        {
          "name": "DEFAULT_SPOT_FAST",
          "emit": "always",
          "encoding": "map",
          "map": {
            "off": "SPOT_FAST_OFF",
            "det": "SPOT_FAST_DET",
            "det_and_gfg": "SPOT_FAST_DET_AND_GFG"
          }
        }
      ]
    },
    "translation_pref": {
      "meson": "acacia_translation_pref",
      "type": "combo",
      "default": "small",
      "choices": [
        "small",
        "any",
        "small+any",
        "deterministic"
      ],
      "description": "Spot translator postprocessor preference list for realizability checks",
      "macros": [
        {
          "name": "ACACIA_TRANSLATION_PREF",
          "emit": "always",
          "encoding": "map",
          "map": {
            "small": "spot::postprocessor::Small",
            "any": "spot::postprocessor::Any",
            "small+any": "spot::postprocessor::Small",
            "deterministic": "spot::postprocessor::Deterministic"
          }
        },
        {
          "name": "ACACIA_TRANSLATION_PREFS",
          "emit": "always",
          "encoding": "map",
          "map": {
            "small": "spot::postprocessor::Small",
            "any": "spot::postprocessor::Any",
            "small+any": "spot::postprocessor::Small, spot::postprocessor::Any",
            "deterministic": "spot::postprocessor::Deterministic"
          }
        }
      ]
    },
    "ltl_frontend": {
      "meson": "acacia_ltl_frontend",
      "type": "combo",
      "default": "baseline",
      "choices": [
        "baseline",
        "mp_nba"
      ],
      "description": "Compile-time LTL frontend selection",
      "macros": [
        {
          "name": "ACACIA_LTL_FRONTEND",
          "emit": "always",
          "encoding": "map",
          "map": {
            "baseline": "ACACIA_LTL_FRONTEND_BASELINE",
            "mp_nba": "ACACIA_LTL_FRONTEND_MP_NBA"
          }
        }
      ]
    },
    "enable_realizability_simplifier": {
      "meson": "acacia_enable_realizability_simplifier",
      "type": "boolean",
      "default": true,
      "description": "Enable Spot realizability-preserving formula simplification before solving and after decomposition",
      "macros": [
        {
          "name": "ACACIA_ENABLE_REALIZABILITY_SIMPLIFIER",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "enable_syntactic_bypass": {
      "meson": "acacia_enable_syntactic_bypass",
      "type": "boolean",
      "default": true,
      "description": "Enable Spot direct-strategy checks before automaton construction",
      "macros": [
        {
          "name": "ACACIA_ENABLE_SYNTACTIC_BYPASS",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "forced_output_contradiction": {
      "meson": "acacia_forced_output_contradiction",
      "type": "boolean",
      "default": false,
      "description": "Enable the forced-output contradiction checker in the decision-only syntactic bypass",
      "macros": [
        {
          "name": "ACACIA_FORCED_OUTPUT_CONTRADICTION",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "profile_dominance": {
      "meson": "acacia_profile_dominance",
      "type": "boolean",
      "default": false,
      "description": "Prune globally dominated semantic actions after decoding, per input",
      "macros": [
        {
          "name": "ACACIA_PROFILE_DOMINANCE",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "forward_eager_minimal_successors": {
      "meson": "acacia_forward_eager_minimal_successors",
      "type": "boolean",
      "default": false,
      "description": "Eagerly apply and Pareto-minimise every forward controller action (comparison mode)",
      "macros": [
        {
          "name": "ACACIA_FORWARD_EAGER_MINIMAL_SUCCESSORS",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "k_schedule": {
      "meson": "acacia_k_schedule",
      "type": "combo",
      "default": "linear",
      "choices": [
        "linear",
        "geometric",
        "cheap_loss_adaptive",
        "direct_max"
      ],
      "description": "Bound-raising schedule for the K loop",
      "macros": [
        {
          "name": "ACACIA_K_SCHEDULE",
          "emit": "always",
          "encoding": "prefix",
          "prefix": "acacia::k_schedule::kind::"
        }
      ]
    },
    "enable_tlsf_frontend": {
      "meson": "acacia_enable_tlsf_frontend",
      "type": "boolean",
      "default": true,
      "description": "Build the optional native TLSF frontend (requires flex and bison)",
      "macros": [
        {
          "name": "ACACIA_ENABLE_TLSF_FRONTEND",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "equivariant_max_states": {
      "meson": "acacia_equivariant_max_states",
      "type": "integer",
      "default": 512,
      "min": 1,
      "description": "Maximum automaton states admitted to unhinted equivariant recognition",
      "macros": [
        {
          "name": "ACACIA_EQUIVARIANT_MAX_STATES",
          "emit": "always",
          "encoding": "value"
        }
      ]
    },
    "symmetry_profile": {
      "meson": "acacia_symmetry_profile",
      "type": "boolean",
      "default": false,
      "description": "Collect and report phase timings and call counts for symmetry and equivariant solving",
      "macros": [
        {
          "name": "ACACIA_SYMMETRY_PROFILE",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "equivariant_max_output_letters": {
      "meson": "acacia_equivariant_max_output_letters",
      "type": "integer",
      "default": 4096,
      "min": 1,
      "description": "Maximum output valuations enumerated for equivariant orbit sweeping; exceeding the cap declines the equivariant solver",
      "macros": [
        {
          "name": "ACACIA_EQUIVARIANT_MAX_OUTPUT_LETTERS",
          "emit": "always",
          "encoding": "value"
        }
      ]
    },
    "equivariant_max_orbits": {
      "meson": "acacia_equivariant_max_orbits",
      "type": "integer",
      "default": 4096,
      "min": 1,
      "description": "Maximum input orbits, including shared-input assignments, admitted to equivariant solving",
      "macros": [
        {
          "name": "ACACIA_EQUIVARIANT_MAX_ORBITS",
          "emit": "always",
          "encoding": "value"
        }
      ]
    },
    "equivariant_max_sweep_clients": {
      "meson": "acacia_equivariant_max_sweep_clients",
      "type": "integer",
      "default": 4,
      "min": 0,
      "description": "Maximum client count for direct orbit sweeping: small orbits can cost less than generator-fixpoint closure; larger groups use the representative/picker loop for greater payoff (0 disables sweeping)",
      "macros": [
        {
          "name": "ACACIA_EQUIVARIANT_MAX_SWEEP_CLIENTS",
          "emit": "always",
          "encoding": "value"
        }
      ]
    },
    "equivariant_exhaustive_detect": {
      "meson": "acacia_equivariant_exhaustive_detect",
      "type": "boolean",
      "default": false,
      "description": "Use exhaustive symmetry detection to select the largest full symmetric subgroup instead of fast star-generator recognition",
      "macros": [
        {
          "name": "ACACIA_EQUIVARIANT_EXHAUSTIVE_DETECT",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "equivariant_validate_fast_recognition": {
      "meson": "acacia_equivariant_validate_fast_recognition",
      "type": "boolean",
      "default": false,
      "description": "Cross-check fast symmetry recognition against exhaustive detection, reporting mismatches and asserting agreement",
      "macros": [
        {
          "name": "ACACIA_EQUIVARIANT_VALIDATE_FAST_RECOGNITION",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "symmetry_verbose_diagnostics": {
      "meson": "acacia_symmetry_verbose_diagnostics",
      "type": "boolean",
      "default": false,
      "description": "Run an additional symmetry-detection pass on the final game automaton for verbose and phase diagnostics",
      "macros": [
        {
          "name": "ACACIA_SYMMETRY_VERBOSE_DIAGNOSTICS",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "equivariant_min_clients": {
      "meson": "acacia_equivariant_min_clients",
      "type": "integer",
      "default": 3,
      "min": 2,
      "description": "Minimum indexed client count admitted to equivariant recognition",
      "macros": [
        {
          "name": "ACACIA_EQUIVARIANT_MIN_CLIENTS",
          "emit": "always",
          "encoding": "value"
        }
      ]
    },
    "equivariant_min_blocks": {
      "meson": "acacia_equivariant_min_blocks",
      "type": "integer",
      "default": 2,
      "min": 0,
      "description": "Minimum client-state block count required by the equivariant solver (0 disables this payoff gate)",
      "macros": [
        {
          "name": "ACACIA_EQUIVARIANT_MIN_BLOCKS",
          "emit": "always",
          "encoding": "value"
        }
      ]
    },
    "simd_is_max": {
      "meson": "acacia_simd_is_max",
      "type": "boolean",
      "default": true,
      "description": "Use SIMD maximum operations for vector comparisons",
      "macros": [
        {
          "name": "SIMD_IS_MAX",
          "emit": "always",
          "encoding": "bool_literal"
        }
      ]
    },
    "decompose_spec": {
      "meson": "acacia_decompose_spec",
      "type": "boolean",
      "default": true,
      "description": "Decompose the specification before solving",
      "macros": [
        {
          "name": "DECOMPOSE_SPEC",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "cpre_avoid_unions": {
      "meson": "acacia_cpre_avoid_unions",
      "type": "boolean",
      "default": false,
      "description": "Avoid unions during controllable predecessor computation",
      "macros": [
        {
          "name": "CPRE_AVOID_UNIONS",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "vector_downset": {
      "meson": "acacia_vector_downset",
      "type": "combo",
      "default": "vector_backed",
      "choices": [
        "vector_backed",
        "vector_or_kdtree_backed",
        "kdtree_backed",
        "bboxtree_backed",
        "comptrie_backed",
        "sharingtree_backed",
        "simple_sharingtree_backed",
        "sharingtrie_backed",
        "skiplist_backed",
        "cst_backed",
        "rank_bucketed_vector_backed",
        "filtered_vector_backed",
        "vector_backed_bin"
      ],
      "description": "Downset implementation for vectors and bitsets",
      "macros": [
        {
          "name": "VECTOR_AND_BITSET_DOWNSET_IMPL",
          "emit": "always",
          "encoding": "value"
        }
      ]
    },
    "no_simd": {
      "meson": "acacia_no_simd",
      "type": "boolean",
      "default": false,
      "description": "Disable SIMD vector operations",
      "macros": [
        {
          "name": "NO_SIMD",
          "emit": "true",
          "encoding": "bare"
        }
      ]
    },
    "compile_all_components": {
      "meson": "acacia_compile_all_components",
      "type": "boolean",
      "default": false,
      "description": "Compile all component family implementations",
      "macros": [
        {
          "name": "ACACIA_COMPILE_ALL_COMPONENTS",
          "emit": "true",
          "encoding": "constant",
          "value": 1
        }
      ]
    },
    "enable_diagnostics": {
      "meson": "acacia_enable_diagnostics",
      "type": "boolean",
      "default": false,
      "description": "Compile compact Acacia phase diagnostics, gated at runtime by ACACIA_DIAG",
      "macros": [
        {
          "name": "ACACIA_ENABLE_DIAGNOSTICS",
          "emit": "true",
          "encoding": "constant",
          "value": 1
        }
      ]
    },
    "default_arms": {
      "meson": "acacia_default_arms",
      "type": "string",
      "default": "",
      "description": "Default portfolio in --arms syntax; empty uses the historical default",
      "macros": [
        {
          "name": "ACACIA_DEFAULT_ARMS",
          "emit": "nonempty",
          "encoding": "c_string"
        }
      ]
    },
    "local_certificate": {
      "meson": "acacia_local_certificate",
      "type": "boolean",
      "default": false,
      "description": "Enable the bounded local winning-certificate and root-refutation probe",
      "macros": [
        {
          "name": "ACACIA_LOCAL_CERTIFICATE",
          "emit": "true",
          "encoding": "constant",
          "value": 1
        }
      ]
    },
    "forward_safety_solver": {
      "meson": "acacia_forward_safety_solver",
      "type": "boolean",
      "default": false,
      "description": "Use the on-the-fly forward safety-game solver instead of the backward antichain fixed point",
      "macros": [
        {
          "name": "ACACIA_FORWARD_SAFETY_SOLVER",
          "emit": "true",
          "encoding": "constant",
          "value": 1
        }
      ]
    },
    "forward_conditional_covering": {
      "meson": "acacia_forward_conditional_covering",
      "type": "boolean",
      "default": false,
      "description": "Enable conditional downward covering of optimistic successors",
      "macros": [
        {
          "name": "ACACIA_FORWARD_CONDITIONAL_COVERING",
          "emit": "true",
          "encoding": "constant",
          "value": 1
        }
      ]
    },
    "enable_equivariant_solver": {
      "meson": "acacia_enable_equivariant_solver",
      "type": "boolean",
      "default": true,
      "description": "Compile and enable the exact equivariant solver path",
      "macros": [
        {
          "name": "ACACIA_ENABLE_EQUIVARIANT_SOLVER",
          "emit": "true",
          "encoding": "constant",
          "value": 1
        }
      ]
    },
    "transition_acceptance": {
      "meson": "acacia_transition_acceptance",
      "type": "boolean",
      "default": false,
      "description": "Carry transition acceptance into rank actions",
      "macros": [
        {
          "name": "ACACIA_TRANSITION_ACCEPTANCE",
          "emit": "always",
          "encoding": "bool_int"
        }
      ]
    },
    "vector_impl": {
      "meson": "acacia_vector_impl",
      "type": "combo",
      "default": "auto",
      "choices": [
        "auto",
        "simd_vector_backed",
        "simd_vector_backed_sum",
        "vector_backed"
      ],
      "description": "Vector implementation; auto selects the default",
      "macros": [
        {
          "name": "VECTOR_IMPL",
          "emit": "not_equal",
          "encoding": "value",
          "skip_value": "auto"
        }
      ]
    }
  },
  "constants": {
    "VECTOR_ELT_T": {
      "value": "signed char",
      "description": "Counter element type. Overflow WARNING: Check VECTOR_ELT_T below before changing DEFAULT_K. The acacia_default_k maximum of 127 in meson.options repeats the same signed-char representation constraint.",
      "sources": [
        "src/configuration.hh",
        "meson.options"
      ]
    },
    "ACACIA_LTL_FRONTEND_BASELINE": {
      "value": 0,
      "description": "Baseline enum value of ACACIA_LTL_FRONTEND, not an option. Together with ACACIA_LTL_FRONTEND_MP_NBA it defines the two admissible values. The template defines it unconditionally; src/configuration.hh guards it with #ifndef.",
      "sources": [
        "src/config/acacia_build_config.hh.in",
        "src/configuration.hh"
      ]
    },
    "ACACIA_LTL_FRONTEND_MP_NBA": {
      "value": 1,
      "description": "MP-NBA enum value of ACACIA_LTL_FRONTEND, not an option. Together with ACACIA_LTL_FRONTEND_BASELINE it defines the two admissible values. The template defines it unconditionally; src/configuration.hh guards it with #ifndef.",
      "sources": [
        "src/config/acacia_build_config.hh.in",
        "src/configuration.hh"
      ]
    },
    "VECTOR_IMPL_AUTO": {
      "value": "NO_SIMD ? vector_backed : simd_vector_backed",
      "description": "Resolution of VECTOR_IMPL when vector_impl is auto. src/configuration.hh selects the fallback by whether NO_SIMD is defined; meson.build repeats the resolution using acacia_no_simd when selecting posets_vector_impl component gates.",
      "sources": [
        "src/configuration.hh",
        "meson.build"
      ]
    }
  }
}
