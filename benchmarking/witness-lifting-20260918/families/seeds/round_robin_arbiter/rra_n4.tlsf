INFO {
  TITLE:       "Round Robin Arbiter";
  DESCRIPTION: "Parameterized Arbiter, where requst signals have to remain HIGH until they are granted";
  SEMANTICS:   Mealy;
  TARGET:      Mealy;
}

MAIN {

  INPUTS {
    r_0;
    r_1;
    r_2;
    r_3;
  }

  OUTPUTS {
    g_0;
    g_1;
    g_2;
    g_3;
  }

    ASSERT {
      (((!(g_0) && !(g_1)) && ((!(g_2) && true) || (true && !(g_3)))) || (((!(g_0) && true) || (true && !(g_1))) && (!(g_2) && !(g_3))));
    }

    ASSUME {
      G ((((((((r_0 && !(g_0)) -> X (r_0)) && ((!(r_0) && g_0) -> X (!(r_0)))) && F (!((r_0 && g_0)))) && ((((r_1 && !(g_1)) -> X (r_1)) && ((!(r_1) && g_1) -> X (!(r_1)))) && F (!((r_1 && g_1))))) && ((((r_2 && !(g_2)) -> X (r_2)) && ((!(r_2) && g_2) -> X (!(r_2)))) && F (!((r_2 && g_2))))) && ((((r_3 && !(g_3)) -> X (r_3)) && ((!(r_3) && g_3) -> X (!(r_3)))) && F (!((r_3 && g_3))))));
    }

    GUARANTEE {
      (((G ((r_0 -> F (g_0))) && G ((r_1 -> F (g_1)))) && G ((r_2 -> F (g_2)))) && G ((r_3 -> F (g_3))));
    }

}
