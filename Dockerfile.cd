FROM gcc:14.2-bookworm

ARG DEBIAN_FRONTEND=noninteractive
ARG SPOT_VERSION=2.15.1
ARG TLSF_TOOLS_LINUX_X86_64_URL=https://github.com/gaperez64/tlsf-tools/releases/download/v1.3/tlsf-tools-v1.3-linux-x86_64-v2.tar.gz

# Build tools (extends syntcomp_tgcc docker_full package list)
RUN apt-get update && \
    apt-get install -y ca-certificates wget cmake autoconf time python3-dev \
        meson ninja-build pkg-config python3-pip \
        automake libtool libltdl-dev bison flex zsh git \
    && rm -rf /var/lib/apt/lists/*

# TLSF frontend tools used by scripts/acacia-bonsai.sh --tlsf.
RUN wget -q -O /tmp/tlsf-tools.tar.gz "$TLSF_TOOLS_LINUX_X86_64_URL" \
    && mkdir -p /tmp/tlsf-tools \
    && tar -xzf /tmp/tlsf-tools.tar.gz --strip-components=1 -C /tmp/tlsf-tools \
    && cd /tmp/tlsf-tools \
    && sha256sum -c SHA256SUMS \
    && install -m 0755 \
        /tmp/tlsf-tools/tlsf2ltl \
        /tmp/tlsf-tools/tlsfinfo \
        /tmp/tlsf-tools/tlsf2tlsf \
        /tmp/tlsf-tools/tlsfnorm \
        /tmp/tlsf-tools/mealy2moore \
        /usr/local/bin/ \
    && cd /tmp \
    && rm -rf /tmp/tlsf-tools /tmp/tlsf-tools.tar.gz \
    && tlsf2ltl --version

# Upgrade meson (bookworm's version may be too old for C++23 project features)
RUN pip3 install --break-system-packages --upgrade meson

# Spot sources — NOT compiled; user compiles with -march=native
WORKDIR /opt/spot
RUN wget -q https://www.lrde.epita.fr/dload/spot/spot-${SPOT_VERSION}.tar.gz \
    && tar -xzf spot-${SPOT_VERSION}.tar.gz \
    && rm spot-${SPOT_VERSION}.tar.gz

# acacia-bonsai sources (with submodules, via checkout in the workflow)
WORKDIR /opt/acacia-bonsai
COPY . .

# Pre-fetch std-simd meson wrap so scripts/compile.sh works fully offline
RUN meson subprojects download std-simd || true

RUN chmod +x scripts/compile.sh scripts/acacia-bonsai.sh scripts/acacia-synthesis.sh

WORKDIR /opt/acacia-bonsai
ENTRYPOINT ["/bin/bash"]
