graph paper_gridworld {
  graph [layout=neato, bgcolor="white", margin=0.08, overlap=false, outputorder=edgesfirst];
  node [fontname="DejaVu Sans", fontsize=10, width=0.55, height=0.55, fixedsize=true, color="#64748b"];
  edge [penwidth=1.25];
  cell_0 [label="s0\n4", pos="0.00,3.45!", shape=box, style=filled, fillcolor="#dcfce7", peripheries=2, color="#f59e0b", penwidth=2.2, xlabel="after one wait", fontcolor="#9a3412"];
  cell_1 [label="s1\n4", pos="1.15,3.45!", shape=box, style=filled, fillcolor="#dcfce7"];
  cell_2 [label="s2", pos="3.45,3.45!", shape=box, style=filled, fillcolor="#f8fafc"];
  cell_3 [label="s3\n1", pos="4.60,3.45!", shape=box, style=filled, fillcolor="#dbeafe"];
  cell_4 [label="s4", pos="0.00,2.30!", shape=box, style=filled, fillcolor="#f8fafc"];
  cell_5 [label="s5", pos="1.15,2.30!", shape=box, style=filled, fillcolor="#f8fafc"];
  cell_6 [label="s6", pos="3.45,2.30!", shape=box, style=filled, fillcolor="#f8fafc"];
  cell_7 [label="s7", pos="4.60,2.30!", shape=box, style=filled, fillcolor="#f8fafc"];
  cell_8 [label="s8", pos="0.00,1.15!", shape=box, style=filled, fillcolor="#f8fafc"];
  cell_9 [label="s9\n3", pos="1.15,1.15!", shape=box, style=filled, fillcolor="#ede9fe"];
  cell_10 [label="s10\ng", pos="2.30,1.15!", shape=diamond, style=filled, fillcolor="#fee2e2"];
  cell_11 [label="s11\n2", pos="3.45,1.15!", shape=box, style=filled, fillcolor="#ffedd5"];
  cell_12 [label="s12", pos="4.60,1.15!", shape=box, style=filled, fillcolor="#f8fafc"];
  cell_13 [label="s13", pos="0.00,0.00!", shape=box, style=filled, fillcolor="#f8fafc"];
  cell_14 [label="s14", pos="1.15,0.00!", shape=box, style=filled, fillcolor="#f8fafc"];
  cell_15 [label="s15", pos="3.45,0.00!", shape=box, style=filled, fillcolor="#f8fafc"];
  cell_16 [label="s16", pos="4.60,0.00!", shape=box, style=filled, fillcolor="#f8fafc"];
  wall_0 [label="#", pos="2.30,3.45!", shape=box, style=filled, fillcolor="#334155", fontcolor="white"];
  wall_1 [label="#", pos="2.30,2.30!", shape=box, style=filled, fillcolor="#334155", fontcolor="white"];
  wall_2 [label="#", pos="2.30,0.00!", shape=box, style=filled, fillcolor="#334155", fontcolor="white"];
  cell_0 -- cell_1 [color="#94a3b8"];
  cell_0 -- cell_4 [color="#94a3b8"];
  cell_1 -- cell_5 [color="#94a3b8"];
  cell_2 -- cell_3 [color="#94a3b8"];
  cell_2 -- cell_6 [color="#94a3b8"];
  cell_3 -- cell_7 [color="#94a3b8"];
  cell_4 -- cell_5 [color="#94a3b8"];
  cell_4 -- cell_8 [color="#94a3b8"];
  cell_5 -- cell_9 [color="#94a3b8"];
  cell_6 -- cell_7 [color="#94a3b8"];
  cell_6 -- cell_11 [color="#94a3b8"];
  cell_7 -- cell_12 [color="#94a3b8"];
  cell_8 -- cell_9 [color="#94a3b8"];
  cell_8 -- cell_13 [color="#94a3b8"];
  cell_9 -- cell_10 [color="#94a3b8"];
  cell_9 -- cell_14 [color="#94a3b8"];
  cell_10 -- cell_11 [color="#94a3b8"];
  cell_11 -- cell_12 [color="#94a3b8"];
  cell_11 -- cell_15 [color="#94a3b8"];
  cell_12 -- cell_16 [color="#94a3b8"];
  cell_13 -- cell_14 [color="#94a3b8"];
  cell_15 -- cell_16 [color="#94a3b8"];
  learner [label="learner proposal", pos="6.1,2.25!", shape=ellipse, fixedsize=false, width=1.45, height=0.65, style=filled, fillcolor="#ffedd5", color="#ea580c", penwidth=1.8];
  north [label="N: wall", pos="6.35,3.7!", shape=box, fixedsize=false, width=1.72, height=0.5, style="rounded,filled", fillcolor="#fecaca", color="#b91c1c", fontcolor="#b91c1c"];
  east [label="E: allowed", pos="7.8,2.75!", shape=box, fixedsize=false, width=1.72, height=0.5, style="rounded,filled", fillcolor="#bbf7d0", color="#15803d", fontcolor="#15803d"];
  south [label="S: allowed", pos="7.8,1.8!", shape=box, fixedsize=false, width=1.72, height=0.5, style="rounded,filled", fillcolor="#bbf7d0", color="#15803d", fontcolor="#15803d"];
  west [label="W: boundary", pos="6.35,0.85!", shape=box, fixedsize=false, width=1.72, height=0.5, style="rounded,filled", fillcolor="#fecaca", color="#b91c1c", fontcolor="#b91c1c"];
  wait16 [label="wait: excluded at k=16", pos="9.75,3.15!", shape=box, fixedsize=false, width=1.72, height=0.5, style="rounded,filled", fillcolor="#fecaca", color="#b91c1c", fontcolor="#b91c1c"];
  wait20 [label="wait: allowed at k=20", pos="9.75,1.4!", shape=box, fixedsize=false, width=1.72, height=0.5, style="rounded,filled", fillcolor="#bbf7d0", color="#15803d", fontcolor="#15803d"];
  learner -- north [color="#94a3b8"];
  learner -- east [color="#94a3b8"];
  learner -- south [color="#94a3b8"];
  learner -- west [color="#94a3b8"];
  envelope [label="same safety boundary\nmore co-Buchi slack = more waiting freedom", pos="9.6,0.15!", shape=note, fixedsize=false, width=2.7, height=0.72, style=filled, fillcolor="#f8fafc"];
}
