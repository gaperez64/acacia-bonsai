FROM gcc:14.2-bookworm

ARG DEBIAN_FRONTEND=noninteractive

# Build tools + SWIG (needed for acacia Python bindings) + Spot build deps
RUN apt-get update && \
    apt-get install -y wget cmake autoconf time python3-dev python3-pip \
        meson ninja-build pkg-config swig \
        automake libtool libltdl-dev bison flex git \
    && rm -rf /var/lib/apt/lists/*

# Bookworm's meson may be too old for this project's C++23 features.
RUN pip3 install --break-system-packages --upgrade meson

# Jupyter notebook server + kernel.
RUN pip3 install --break-system-packages notebook ipykernel

# Build Spot 2.14.4 WITH Python bindings into /opt/spot_install.
# (The project's compile.sh uses --disable-python; this image explicitly
# enables the bindings since that is the whole point of a Jupyter image.)
WORKDIR /opt/spot
RUN wget -q http://www.lrde.epita.fr/dload/spot/spot-2.14.4.tar.gz \
    && tar -xzf spot-2.14.4.tar.gz \
    && rm spot-2.14.4.tar.gz
WORKDIR /opt/spot/spot-2.14.4
RUN ./configure --enable-max-accsets=64 --prefix=/opt/spot_install \
    && make -j"$(nproc)" \
    && make install \
    && echo "/opt/spot_install/lib" > /etc/ld.so.conf.d/spot.conf \
    && ldconfig

# acacia-bonsai sources.
WORKDIR /opt/acacia-bonsai
COPY . .

# Pre-fetch the std-simd meson wrap so the meson build works offline.
RUN meson subprojects download std-simd || true

# Build a single release configuration so src/python/_acacia_boomslang.so exists.
# PKG_CONFIG_PATH lets meson find Spot in the custom /opt/spot_install prefix.
ENV PKG_CONFIG_PATH=/opt/spot_install/lib/pkgconfig
RUN meson setup builddir --buildtype=release -Dbuild_python=true \
    && meson compile -C builddir

RUN chmod +x scripts/launch-jupyter.sh

EXPOSE 8888
ENTRYPOINT ["/opt/acacia-bonsai/scripts/launch-jupyter.sh"]
