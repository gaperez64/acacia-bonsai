#!/bin/zsh -f

ACABONSAI=@ACABONSAI@
LTLSYNT=@LTLSYNT@
SYFCO=@SYFCO@
export LD_LIBRARY_PATH=${ACABONSAI:h}/../subprojects/spot/dist/usr/local/lib:${ACABONSAI:h}/../subprojects/spot/dist/usr/local/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH

childpid=
childunit=
ltlsynt_tmp=

test_cgroup_enabled () {
    case ${ACACIA_TEST_CGROUP:-0} in
        1|true|yes|on|auto|strict) return 0;;
        *) return 1;;
    esac
}

resource_unknown_enabled () {
    case ${ACACIA_TEST_RESOURCE_UNKNOWN:-0} in
        1|true|yes|on) return 0;;
        *) return 1;;
    esac
}

stop_child () {
  if [[ $childunit != '' ]]; then
    systemctl --user stop "$childunit.scope" >/dev/null 2>&1
  fi
  if [[ $childpid != '' ]]; then
    kill -TERM $childpid 2>/dev/null
    wait $childpid 2>/dev/null
  fi
}

cleanup_ltlsynt_tmp () {
  if [[ -n $ltlsynt_tmp ]]; then
    rm -f -- "$ltlsynt_tmp" "$ltlsynt_tmp.ltl" "$ltlsynt_tmp.part" \
        "$ltlsynt_tmp.err"
    ltlsynt_tmp=
  fi
}

# Handling most common signals with a trap
TRAPINT () {
  stop_child
  cleanup_ltlsynt_tmp
  exit
}
TRAPQUIT () {
  stop_child
  cleanup_ltlsynt_tmp
  exit
}
TRAPTERM () {
  stop_child
  cleanup_ltlsynt_tmp
  exit
}

echoandrun () {
    echo "$@"
    childunit=
    if test_cgroup_enabled; then
        if ! systemctl --user show-environment >/dev/null 2>&1; then
            print -u2 -- 'error: ACACIA_TEST_CGROUP is enabled, but the user systemd manager is unavailable.'
            return 127
        fi
        local memory_max=${ACACIA_TEST_CGROUP_MEMORY_MAX:-}
        if [[ -z $memory_max ]]; then
            print -u2 -- 'error: ACACIA_TEST_CGROUP_MEMORY_MAX must be set when ACACIA_TEST_CGROUP is enabled.'
            return 127
        fi
        local -a props
        props=("--property=MemoryMax=$memory_max")
        [[ -n ${ACACIA_TEST_CGROUP_SWAP_MAX:-} ]] && props+=("--property=MemorySwapMax=$ACACIA_TEST_CGROUP_SWAP_MAX")
        childunit=acacia-bonsai-test-${$}-${RANDOM}
        systemd-run --user --scope --quiet "--unit=$childunit" $props "$@"&
    else
        "$@"&
    fi
    childpid=$!
    wait $childpid
    local res=$?
    childpid=
    childunit=
    if (( res == 137 )) && resource_unknown_enabled; then
        print -u2 -- 'RESOURCE LIMIT: cgroup killed the solver process; treating this benchmark instance as UNKNOWN.'
        return 2
    fi
    return $res
}

parttoinsouts () {
    ins=
    outs=
    local target=
    while IFS= read -r line || [[ -n $line ]]; do
        # Match benchmarking/benchlib.py:read_part: ignore comments and
        # whitespace, accept comma-separated lists and continuation lines,
        # and preserve a declared empty side as an empty argument.
        line=${line%%\#*}
        # Note the -r, it's mandatory for non-GNU sed implementations.
        line=$(print -r -- "$line" | sed -r \
            's/^[[:space:],]+//;s/[[:space:],]+$//;s/[[:space:],]+/,/g')
        [[ -z $line ]] && continue

        case "${line:l}" in
            .inputs*)
                target=inputs
                args=${line#???????}
                args=${args#,}
                ;;
            .outputs*)
                target=outputs
                args=${line#????????}
                args=${args#,}
                ;;
            *) args=$line;;
        esac
        [[ -z $args ]] && continue
        case "$target" in
            inputs) ins=${ins:+$ins,}$args;;
            outputs) outs=${outs:+$outs,}$args;;
        esac
    done < "$1"
}

run_ltlsynt () {
    local syfco_semantics syfco_component machine_model strict
    local -a semantics_opts
    semantics_opts=()
    if [[ -n $tlsf ]]; then
        if [[ ! -x $SYFCO ]]; then
            print -u2 -- "error: syfco executable is missing or not executable: $SYFCO"
            return 127
        fi
        ltlsynt_tmp=$(mktemp "${TMPDIR:-/tmp}/check-real-correct.XXXXXXXXXX") || {
            print -u2 -- 'error: could not create temporary files for syfco.'
            return 127
        }
        if ! syfco_semantics=$("$SYFCO" --print-semantics "$tlsf" \
                                  2> "$ltlsynt_tmp.err"); then
            print -u2 -- "error: syfco could not read the semantics of $tlsf"
            [[ -s $ltlsynt_tmp.err ]] && print -u2 -- "$(<$ltlsynt_tmp.err)"
            cleanup_ltlsynt_tmp
            return 127
        fi
        machine_model=
        strict=
        for syfco_component in ${(s:,:)syfco_semantics}; do
            syfco_component=${syfco_component//[[:space:]]/}
            case ${syfco_component:l} in
                mealy) machine_model=Mealy;;
                moore) machine_model=Moore;;
                strict) strict=t;;
                *)
                    print -u2 -- "error: unsupported TLSF semantics reported by syfco: $syfco_semantics"
                    cleanup_ltlsynt_tmp
                    return 127
                    ;;
            esac
        done
        if [[ -z $machine_model ]]; then
            print -u2 -- "error: unsupported TLSF semantics reported by syfco: $syfco_semantics"
            cleanup_ltlsynt_tmp
            return 127
        fi

        if [[ -n $strict ]]; then
            print -u2 -- 'warning: ltlsynt has no strict-semantics support and is being given the non-strict reading.'
        fi
        semantics_opts=("--semantics=$machine_model")
        if ! "$SYFCO" --format ltlxba --mode fully \
             --part-file "$ltlsynt_tmp.part" "$tlsf" \
             > "$ltlsynt_tmp.ltl" 2> "$ltlsynt_tmp.err"; then
            print -u2 -- "error: syfco could not convert $tlsf"
            [[ -s $ltlsynt_tmp.err ]] && print -u2 -- "$(<$ltlsynt_tmp.err)"
            cleanup_ltlsynt_tmp
            return 127
        fi
        ltl=$ltlsynt_tmp.ltl
        parttoinsouts "$ltlsynt_tmp.part"
        echo "TLSF converter: $SYFCO ($("$SYFCO" --version))"
    fi
    echo "Running ltlsynt..."
    if [[ ! -x $LTLSYNT ]]; then
        print -u2 -- "error: ltlsynt executable is missing or not executable: $LTLSYNT"
        cleanup_ltlsynt_tmp
        return 127
    fi
    # ltlsynt --realizability exits 0 for REALIZABLE and 1 for UNREALIZABLE,
    # which matches the expect==0 / expect==1 convention used below — so we
    # rely on the exit status directly and do not need to parse stdout.
    echoandrun $prog_prefix "$LTLSYNT" --realizability -F "$ltl" --ins="$ins" --outs="$outs" \
         $semantics_opts ${=LTLSYNT_OPTS} $extra_opts
    local res=$?
    cleanup_ltlsynt_tmp
    return $res
}

run_acacia_bonsai () {
    echo "Running Acacia Bonsai..."
    if [[ ! -x $ACABONSAI ]]; then
        print -u2 -- "error: Acacia Bonsai executable is missing or not executable: $ACABONSAI"
        return 127
    fi
    if [[ -n $tlsf ]]; then
        echoandrun env ACACIA_DIAG_INSTANCE=${tlsf:t} $prog_prefix "$ACABONSAI" -T "$tlsf" \
             ${=AB_OPTS} $extra_opts
    else
        echoandrun env ACACIA_DIAG_INSTANCE=${ltl:t} $prog_prefix "$ACABONSAI" -F "$ltl" -i "$ins" -o "$outs" \
             ${=AB_OPTS} $extra_opts
    fi
}

PROG=$0
usage () {
    cat <<EOF
Usage: $PROG [-p] -[la+] [-e PROG_PATH] (-F LTL_FILE [-P PART_FILE] | -T TLSF_FILE) [-- OPTS...]
Runs ltlsynt or acacia-bonsai on an LTL or TLSF file:
  -p: prefix every line with the name of the test (useful for meson logging)
  -l: run ltlsynt ($LTLSYNT); with -T, convert the TLSF using syfco first
  -a: run acacia-bonsai ($ACABONSAI)
  -V: run using Valgrind
  -v: verbose
  -c: prefix the executable with valgrind --tool=callgrind
  -e EXE_PATH: overwrite the path for the executable
  -o EXTRA_OPTS: extra options to the executable
  -F LTL_FILE: file to test
  -P PART_FILE: part file for LTL_FILE; if not provided, infered from LTL_FILE.
  -T TLSF_FILE: TLSF file to pass natively to Acacia or convert for ltlsynt.

The leftover OPTS... are passed as options to the executable.

If LTL_FILE contains "realizable" or "unrealizable", then this is assumed to be
the correct answer.  Otherwise, ltlsynt is ran on it to have a reference point.

The time printed is retrieved using time(1) (or the ZSH builtin).

Additionally, extra options are passed to the tools using environment variables:
LTLSYNT_OPTS, STRIX_OPTS, AB_OPTS, AP_OPTS.
EOF
    exit 1
}

PYTHON=${PYTHON:-$(whence python3)}
progs=()
while getopts "vcplsa+Ve:o:F:P:T:hx" opt; do
    case $opt; in
        p) prefix=t;;
        [lsa+]) progs+=$opt;;
        V) prog_prefix=(valgrind --error-exitcode=18 --exit-on-first-error=yes);;
        c) prog_prefix=(valgrind --tool=callgrind);;
        e) forced_path=$OPTARG;;
        F) ltl=$OPTARG;;
        P) part=$OPTARG;;
        T) tlsf=$OPTARG;;
        x) setopt xtrace;;
        v) verbose=t;;
        h|*) usage;;
    esac
done

shift $((OPTIND - 1))
extra_opts+=("$@")

if (( ${#progs} == 0 )); then
    echo 'error: one program should be specified.'
    exit 7
fi
if [[ -n $ltl && -n $tlsf ]]; then
    echo 'error: -F and -T are mutually exclusive.'
    exit 8
fi
if [[ -n $tlsf ]]; then
    # Meson bakes the corpus directory in at configure time, so a build whose
    # corpus has since moved could not be gated at all without reconfiguring
    # and recompiling.  The corpus is flat, so an exported ACACIA_TLSF_CORPUS
    # names the same file under a live directory.  See issue #134.
    if ! [[ -e $tlsf ]] && [[ -n ${ACACIA_TLSF_CORPUS:-} ]]; then
        relocated=$ACACIA_TLSF_CORPUS/${tlsf:t}
        if [[ -e $relocated ]]; then
            tlsf=$relocated
        fi
    fi
    if ! [[ -e $tlsf ]]; then
        echo "error: $tlsf should exist."
        exit 8
    fi
else
    part=${part:-${ltl/.ltl/.part}}
    if ! [[ -e $ltl && -e $part ]]; then
        echo "error: $ltl and $part should exist."
        exit 8
    fi
    parttoinsouts "$part"
fi

## Prefix output with the test file name.
if [[ $prefix ]]; then
    subject=${tlsf:-$ltl}
    shortfile=${subject/*tests\//}
   exec >  >(sed "s!^![$shortfile] !")
   exec 2> >(sed "s!^![$shortfile] !" >&2)
fi

[[ $verbose && -n $ltl ]] && echo "formula: $(cat $ltl)"

## Guess realizability, or find it
subject=${tlsf:-$ltl}
case $subject; in
    */realizable/*)   expect=0;;
    */unrealizable/*) expect=1;;
    *) echo 'Realizability not established.'
       expect=2
       ;;
esac

if (( expect == 1 )); then
    echo "formula is unrealizable."
elif (( expect == 0 )); then
    echo "formula is realizable."
fi

ret=0
for prog in $progs; do
    case $prog; in
        l) run_ltlsynt;;
        a) run_acacia_bonsai;;
    esac
    res=$?
    if (( res == 2 || res > 2 || (expect < 2 && res != expect) )); then
        echo -n "FAILED: "
        if (( res > 128 )); then
            echo "ERROR: CRASH $res"
            ret=$res
        elif (( res == 2 )); then
            echo "NO VERDICT: UNKNOWN (return $res)"
            ret=3
        elif [[ $prog == 'l' ]]; then
            echo 'ERROR: ltlsynt failed.'
            ret=13
        elif (( res == 3 )); then
            echo "ERROR: RETURNED $res"
            ret=3
        elif (( res > 2 )); then
            echo "ERROR: RETURNED $res"
            ret=3
        elif (( expect == 0 )); then
	    echo "FALSE NEGATIVE $res"
            ret=1
        elif (( expect == 1 )); then
	    echo "FALSE POSITIVE $res"
            ret=2
        fi
    fi
done

if (( ret == 0 )); then
    echo "PASS."
    exit 0
fi

exit $ret
