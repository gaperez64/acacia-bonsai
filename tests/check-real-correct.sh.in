#!/bin/zsh -f

ACABONSAI=@ACABONSAI@
LTLSYNT=@LTLSYNT@
export LD_LIBRARY_PATH=${ACABONSAI:h}/../subprojects/spot/dist/usr/local/lib:${ACABONSAI:h}/../subprojects/spot/dist/usr/local/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH

childpid=
childunit=

test_cgroup_enabled () {
    case ${ACACIA_TEST_CGROUP:-0} in
        1|true|yes|on|auto|strict) return 0;;
        *) return 1;;
    esac
}

resource_unknown_enabled () {
    case ${ACACIA_TEST_RESOURCE_UNKNOWN:-0} in
        1|true|yes|on) return 0;;
        *) return 1;;
    esac
}

stop_child () {
  if [[ $childunit != '' ]]; then
    systemctl --user stop "$childunit.scope" >/dev/null 2>&1
  fi
  if [[ $childpid != '' ]]; then
    kill -TERM $childpid 2>/dev/null
    wait $childpid 2>/dev/null
  fi
}

# Handling most common signals with a trap
TRAPINT () {
  stop_child
  exit
}
TRAPQUIT () {
  stop_child
  exit
}
TRAPTERM () {
  stop_child
  exit
}

echoandrun () {
    echo "$@"
    childunit=
    if test_cgroup_enabled; then
        local memory_max=${ACACIA_TEST_CGROUP_MEMORY_MAX:-}
        if [[ -z $memory_max ]]; then
            print -u2 -- 'error: ACACIA_TEST_CGROUP_MEMORY_MAX must be set when ACACIA_TEST_CGROUP is enabled.'
            return 127
        fi
        local -a props
        props=("--property=MemoryMax=$memory_max")
        [[ -n ${ACACIA_TEST_CGROUP_SWAP_MAX:-} ]] && props+=("--property=MemorySwapMax=$ACACIA_TEST_CGROUP_SWAP_MAX")
        childunit=acacia-bonsai-test-${$}-${RANDOM}
        systemd-run --user --scope --quiet "--unit=$childunit" $props "$@"&
    else
        "$@"&
    fi
    childpid=$!
    wait $childpid
    local res=$?
    childpid=
    childunit=
    if (( res == 137 )) && resource_unknown_enabled; then
        print -u2 -- 'RESOURCE LIMIT: cgroup killed the solver process; treating this benchmark instance as UNKNOWN.'
        return 2
    fi
    return $res
}

parttoinsouts () {
    while IFS= read line; do
	# Note the -r, it's mandatory for non-GNU sed implementations
        line=$(echo "$line" | sed -r 's/[[:space:]]*$//;s/[[:space:]]+/,/g')
        head=${line/,*/}
        args=${line/$head,/}
        case "$head" in
            .inputs) ins=$args;;
            .outputs) outs=$args;;
        esac
    done < $1
}

run_ltlsynt () {
    echo "Running ltlsynt..."
    if [[ ! -x $LTLSYNT ]]; then
        print -u2 -- "error: ltlsynt executable is missing or not executable: $LTLSYNT"
        return 127
    fi
    # ltlsynt --realizability exits 0 for REALIZABLE and 1 for UNREALIZABLE,
    # which matches the expect==0 / expect==1 convention used below — so we
    # rely on the exit status directly and do not need to parse stdout.
    echoandrun $prog_prefix $LTLSYNT --realizability -F $ltl --ins=$ins --outs=$outs \
         ${=LTLSYNT_OPTS} $extra_opts
}

run_acacia_bonsai () {
    echo "Running Acacia Bonsai..."
    if [[ ! -x $ACABONSAI ]]; then
        print -u2 -- "error: Acacia Bonsai executable is missing or not executable: $ACABONSAI"
        return 127
    fi
    echoandrun env ACACIA_DIAG_INSTANCE=${ltl:t} $prog_prefix $ACABONSAI -F $ltl -i $ins -o $outs \
         ${=AB_OPTS} $extra_opts
}

PROG=$0
usage () {
    cat <<EOF
Usage: $PROG [-p] -[la+] [-e PROG_PATH] -F LTL_FILE [-P PART_FILE] [-- OPTS...]
Runs ltlsynt, acacia-bonsai, or acacia-+ on the input LTL_FILE:
  -p: prefix every line with the name of the test (useful for meson logging)
  -l: run ltlsynt ($LTLSYNT)
  -a: run acacia-bonsai ($ACABONSAI)
  -V: run using Valgrind
  -v: verbose
  -c: prefix the executable with valgrind --tool=callgrind
  -e EXE_PATH: overwrite the path for the executable
  -o EXTRA_OPTS: extra options to the executable
  -F LTL_FILE: file to test
  -P PART_FILE: part file for LTL_FILE; if not provided, infered from LTL_FILE.

The leftover OPTS... are passed as options to the executable.

If LTL_FILE contains "realizable" or "unrealizable", then this is assumed to be
the correct answer.  Otherwise, ltlsynt is ran on it to have a reference point.

The time printed is retrieved using time(1) (or the ZSH builtin).

Additionally, extra options are passed to the tools using environment variables:
LTLSYNT_OPTS, STRIX_OPTS, AB_OPTS, AP_OPTS.
EOF
    exit 1
}

PYTHON=${PYTHON:-$(whence python3)}
progs=()
while getopts "vcplsa+Ve:o:F:P:hx" opt; do
    case $opt; in
        p) prefix=t;;
        [lsa+]) progs+=$opt;;
        V) prog_prefix=(valgrind --error-exitcode=18 --exit-on-first-error=yes);;
        c) prog_prefix=(valgrind --tool=callgrind);;
        e) forced_path=$OPTARG;;
        F) ltl=$OPTARG;;
        P) part=$OPTARG;;
        x) setopt xtrace;;
        v) verbose=t;;
        h|*) usage;;
    esac
done

part=${part:-${ltl/.ltl/.part}}

shift $((OPTIND - 1))
extra_opts+=("$@")

if (( ${#progs} == 0 )); then
    echo 'error: one program should be specified.'
    exit 7
fi
if ! [[ -e $ltl && -e $part ]]; then
    echo "error: $ltl and $part should exist."
    exit 8
fi

parttoinsouts $part

## Prefix output with the test file name.
if [[ $prefix ]]; then
    shortfile=${ltl/*tests\//}
   exec >  >(sed "s!^![$shortfile] !")
   exec 2> >(sed "s!^![$shortfile] !" >&2)
fi

[[ $verbose ]] && echo "formula: $(cat $ltl)"

## Guess realizability, or find it
case $ltl; in
    */realizable/*)   expect=0;;
    */unrealizable/*) expect=1;;
    *) echo 'Realizability not established.'
       expect=2
       ;;
esac

if (( expect == 1 )); then
    echo "formula is unrealizable."
elif (( expect == 0 )); then
    echo "formula is realizable."
fi

ret=0
for prog in $progs; do
    case $prog; in
        l) run_ltlsynt;;
        a) run_acacia_bonsai;;
    esac
    res=$?
    if (( res == 2 || res > 2 || (expect < 2 && res != expect) )); then
        echo -n "FAILED: "
        if (( res > 128 )); then
            echo "ERROR: CRASH $res"
            ret=$res
        elif (( res == 2 )); then
            echo "NO VERDICT: UNKNOWN (return $res)"
            ret=3
        elif [[ $prog == 'l' ]]; then
            echo 'ERROR: ltlsynt failed.'
            ret=13
        elif (( res == 3 )); then
            echo "ERROR: RETURNED $res"
            ret=3
        elif (( res > 2 )); then
            echo "ERROR: RETURNED $res"
            ret=3
        elif (( expect == 0 )); then
	    echo "FALSE NEGATIVE $res"
            ret=1
        elif (( expect == 1 )); then
	    echo "FALSE POSITIVE $res"
            ret=2
        fi
    fi
done

if (( ret == 0 )); then
    echo "PASS."
    exit 0
fi

exit $ret
