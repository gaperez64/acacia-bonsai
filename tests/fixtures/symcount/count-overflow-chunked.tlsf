INFO { TITLE: "Count overflow" DESCRIPTION: "A global input cannot be forced true" SEMANTICS: Mealy TARGET: Mealy }
GLOBAL { PARAMETERS { n = 65536; } }
MAIN {
  INPUTS { x; }
  OUTPUTS { b[n]; }
  GUARANTEES {
    G (&&[0 <= i < n/2] b[i]);
    G (&&[n/2 <= i < n] b[i]);
    G (&&[0 <= i < n/2] (b[i] -> x));
    G (&&[n/2 <= i < n] (b[i] -> x));
  }
}
