INFO {
  TITLE: "Indexed recurrence"
  DESCRIPTION: "Signals whether every input recurs, with a token between signals"
  SEMANTICS: Mealy
  TARGET: Mealy
}

GLOBAL {
  PARAMETERS { n = 14; }
}

MAIN {
  INPUTS { finished[n]; }
  OUTPUTS { allFinished; }
  ASSERT {
    &&[0 <= i < n] (allFinished -> X (!allFinished W finished[i]));
  }
  GUARANTEES {
    G F allFinished <-> &&[0 <= i < n] G F finished[i];
  }
}
