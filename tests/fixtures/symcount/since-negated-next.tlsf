INFO { TITLE: "Negated since monitor under X" DESCRIPTION: "All clients satisfy b from the second letter" SEMANTICS: Mealy TARGET: Mealy }
GLOBAL { PARAMETERS { n = 2; } }
MAIN {
  OUTPUTS { x; b[n]; }
  GUARANTEES {
    G x;
    &&[0 <= i < n] (!b[i] && X (G b[i]));
    !(X (G ((G x) -> (||[0 <= i < n] G b[i]))));
  }
}
