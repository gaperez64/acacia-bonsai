option('build_tests', type: 'boolean', value: true,
       description: 'Build the test suite')
option('build_python', type: 'boolean', value: false,
       description: 'Build the Python interface (requires swig)')
option('acacia_tlsf_corpus_dir', type: 'string', value: '',
       description: 'Path to the directory produced by benchmarking/syntcomp-corpus.py materialize')
option('acacia_compiler_profile', type: 'combo',
       choices: ['debug', 'release', 'lowmem'],
       value: 'debug',
       description: 'Extra compiler flags for Acacia local benchmarking profiles')
option('acacia_preset', type: 'string', value: '',
       description: 'Named build configuration; empty for a hand-assembled configuration')

option('acacia_aut_preprocessor', type: 'combo',
       choices: ['surely_losing', 'standard'],
       value: 'surely_losing',
       description: 'Compile-time automaton preprocessor selection')

option('acacia_ios_precomputer', type: 'combo',
       choices: ['standard', 'mona', 'semantic_mona'],
       value: 'standard')

option('acacia_input_picker', type: 'combo',
       choices: ['critical_pq', 'critical'],
       value: 'critical_pq')

option('acacia_translation_pref', type: 'combo',
       choices: ['small', 'any'],
       value: 'small',
       description: 'Spot translator postprocessor preference list for realizability checks')

option('acacia_forced_output_contradiction', type: 'boolean', value: false,
       description: 'Enable the forced-output contradiction checker in the decision-only syntactic bypass')

option('acacia_simd_is_max', type: 'boolean', value: true)

option('acacia_enable_diagnostics', type: 'boolean', value: false,
       description: 'Compile compact Acacia phase diagnostics, gated at runtime by ACACIA_DIAG')
# A portfolio the build ships by default, in --arms syntax
# (polarity:transform:backend, comma separated).  Empty keeps the historical
# default portfolio, so every existing build is unaffected.  This exists because
# the best measured configuration is an arm mix rather than a compile-time
# backend choice, and a shipped configuration has to be able to say so.
option('acacia_default_arms', type: 'string', value: '',
       description: 'Default portfolio in --arms syntax; empty uses the historical default')

option('acacia_spot_guarded_backend', type: 'boolean', value: false,
       description: 'Compile the explicitly selected Spot guarded-input safety-game backend')

option('acacia_spot_lazy_provider', type: 'boolean', value: false,
       description: 'Compile the explicitly selected Spot TAA provider for real and formula-unreal workers')
option('acacia_forward_safety_solver', type: 'boolean', value: false,
       description: 'Use the on-the-fly forward safety-game solver instead of the backward antichain fixed point')
option('acacia_enable_equivariant_solver', type: 'boolean', value: true,
       description: 'Compile and enable the exact equivariant solver path')

option('acacia_vector_downset', type: 'combo',
       choices: ['vector_backed', 'rank_bucketed_vector_backed'],
       value: 'vector_backed')
