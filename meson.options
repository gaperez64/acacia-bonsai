option('build_tests', type: 'boolean', value: true,
       description: 'Build the test suite')
option('build_python', type: 'boolean', value: false,
       description: 'Build the Python interface (requires swig)')
option('build_research_tools', type: 'boolean', value: false,
       description: 'Build uninstalled experiment helpers such as HOA replay')
option('acacia_enable_tlsf_frontend', type: 'boolean', value: false,
       description: 'Build the optional native TLSF frontend (requires flex and bison)')
option('acacia_tlsf_corpus_dir', type: 'string', value: '',
       description: 'Path to the directory produced by benchmarking/syntcomp-corpus.py materialize')
option('acacia_compiler_profile', type: 'combo',
       choices: ['debug', 'release', 'lowmem'],
       value: 'debug',
       description: 'Extra compiler flags for Acacia local benchmarking profiles')

option('acacia_aut_preprocessor', type: 'combo',
       choices: ['surely_losing', 'no_preprocessing', 'standard', 'elevator'],
       value: 'surely_losing',
       description: 'Compile-time automaton preprocessor selection')
option('acacia_boolean_states', type: 'combo',
       choices: ['forward_saturation', 'no_boolean_states', 'transition_core'],
       value: 'forward_saturation',
       description: 'Which states get numeric rank coordinates; transition_core is the transition-acceptance counterpart of forward_saturation')
option('acacia_ios_precomputer', type: 'combo',
       choices: ['standard', 'delegate', 'fake_vars', 'powset', 'mona',
                 'semantic_mona'],
       value: 'standard')
option('acacia_actioner', type: 'combo',
       choices: ['standard', 'no_ios_precomputation'],
       value: 'standard')
option('acacia_input_picker', type: 'combo',
       choices: ['critical_pq', 'critical', 'critical_rnd', 'critical_fullrnd'],
       value: 'critical_pq')

option('acacia_default_k', type: 'integer', value: 99, min: 1, max: 127,
       description: 'Default final K (bounded by the signed-char counter representation)')
option('acacia_default_kmin', type: 'integer', value: 2, min: 1, max: 127,
       description: 'Default initial K (must not exceed acacia_default_k at runtime)')
option('acacia_default_kinc', type: 'integer', value: 3, min: 1, max: 127,
       description: 'Default K increment')
option('acacia_default_unreal_x', type: 'combo',
       choices: ['both', 'automaton', 'formula'],
       value: 'both')
option('acacia_default_spot_fast', type: 'combo',
       choices: ['off', 'det', 'det_and_gfg'],
       value: 'det')
option('acacia_translation_pref', type: 'combo',
       choices: ['small', 'any', 'small+any', 'deterministic'],
       value: 'small',
       description: 'Spot translator postprocessor preference list for realizability checks')
option('acacia_ltl_frontend', type: 'combo',
       choices: ['baseline', 'mp_nba'],
       value: 'baseline',
       description: 'Compile-time LTL frontend selection')
option('acacia_enable_realizability_simplifier', type: 'boolean', value: true,
       description: 'Enable Spot realizability-preserving formula simplification before solving and after decomposition')
option('acacia_enable_syntactic_bypass', type: 'boolean', value: true,
       description: 'Enable Spot direct-strategy checks before automaton construction')
option('acacia_simd_is_max', type: 'boolean', value: true)
option('acacia_decompose_spec', type: 'boolean', value: true)
option('acacia_cpre_avoid_unions', type: 'boolean', value: false)
option('acacia_no_simd', type: 'boolean', value: false)
option('acacia_compile_all_components', type: 'boolean', value: false)
option('acacia_enable_diagnostics', type: 'boolean', value: false,
       description: 'Compile compact Acacia phase diagnostics, gated at runtime by ACACIA_DIAG')
option('acacia_local_certificate', type: 'boolean', value: false,
       description: 'Enable the bounded local winning-certificate and root-refutation probe')
option('acacia_enable_equivariant_solver', type: 'boolean', value: true,
       description: 'Compile and enable the exact equivariant solver path')
option('acacia_transition_acceptance', type: 'boolean', value: false,
       description: 'Carry transition acceptance into rank actions')
option('acacia_equivariant_max_states', type: 'integer', value: 512, min: 1,
       description: 'Maximum automaton states admitted to unhinted equivariant recognition')
option('acacia_equivariant_min_clients', type: 'integer', value: 3, min: 2,
       description: 'Minimum indexed client count admitted to equivariant recognition')
option('acacia_equivariant_min_blocks', type: 'integer', value: 2, min: 0,
       description: 'Minimum client-state block count required by the equivariant solver (0 disables this payoff gate)')

option('acacia_vector_downset', type: 'combo',
       choices: [
         'vector_backed',
         'vector_or_kdtree_backed',
         'kdtree_backed',
         'bboxtree_backed',
         'comptrie_backed',
         'sharingtree_backed',
         'simple_sharingtree_backed',
         'sharingtrie_backed',
         'skiplist_backed',
         'cst_backed',
         'rank_bucketed_vector_backed',
         'filtered_vector_backed',
         'vector_backed_bin',
       ],
       value: 'vector_backed')
option('acacia_vector_impl', type: 'combo',
       choices: ['auto', 'simd_vector_backed', 'simd_vector_backed_sum', 'vector_backed'],
       value: 'auto')
